# ---------------------------------------------------------------------------
# Umgebungsvariablen für die Astro-Webseite
# Kopiere diese Datei zu ".env" und trage die echten Werte ein.
# Die ".env"-Datei darf NIEMALS ins Repository eingecheckt werden!
# ---------------------------------------------------------------------------

# Sanity Projekt-ID (zu finden unter https://www.sanity.io/manage im jeweiligen Projekt)
SANITY_PROJECT_ID=xxxxxxxx

# Sanity Dataset-Name (Standard bei neuen Projekten: production)
SANITY_DATASET=production

# Sanity API-Version im Format YYYY-MM-DD (einfach das heutige Datum beim Einrichten verwenden)
SANITY_API_VERSION=2024-01-01

# Optionales Lese-Token, NUR nötig falls das Dataset auf "privat" gestellt ist.
# Für ein öffentliches Dataset (Standard) leer lassen.
# Niemals ein Schreib-Token hier eintragen und niemals öffentlich sichtbar machen!
SANITY_API_READ_TOKEN=

# Basis-URL der Webseite, wird für Sitemap, Canonical-Links und Open-Graph-Tags benötigt
PUBLIC_SITE_URL=https://www.beispiel-kosmetikstudio.de

# Standard-Buchungslink (Fallback), falls in Sanity noch keine Planity-URL gepflegt wurde
PUBLIC_PLANITY_URL=https://www.planity.com/
