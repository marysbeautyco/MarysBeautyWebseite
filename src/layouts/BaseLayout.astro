---
import '../styles/global.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import BookingButton from '../components/BookingButton.astro';
import { sanityFetch } from '../lib/sanity';
import { siteSettingsQuery } from '../lib/queries';
import { siteSettingsFallback } from '../lib/content';
import type { Seo as SeoType, SiteSettings } from '../types/sanity';

interface Props {
  title: string;
  description: string;
  seo?: SeoType;
  structuredData?: Record<string, unknown>[];
}

const { title, description, seo, structuredData } = Astro.props;

const siteSettings = (await sanityFetch<SiteSettings>(siteSettingsQuery)) ?? siteSettingsFallback;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2d2a27" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <Seo title={title} description={description} seo={seo} siteSettings={siteSettings} structuredData={structuredData} />
  </head>
  <body>
    <a href="#inhalt" class="skip-link">Zum Inhalt springen</a>
    <Header siteSettings={siteSettings} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer siteSettings={siteSettings} />
    <div class="booking-fab">
      <BookingButton url={siteSettings.planityUrl} label="Termin buchen" />
    </div>

    <script>
      // Dezente Einblend-Animation beim Scrollen – respektiert prefers-reduced-motion
      // über CSS (siehe global.scss) und fällt ohne IntersectionObserver-Support
      // einfach auf sichtbare Inhalte zurück.
      if ('IntersectionObserver' in window) {
        const beobachter = new IntersectionObserver(
          (eintraege) => {
            for (const eintrag of eintraege) {
              if (eintrag.isIntersecting) {
                eintrag.target.classList.add('is-visible');
                beobachter.unobserve(eintrag.target);
              }
            }
          },
          { threshold: 0.15 }
        );
        document.querySelectorAll('.fade-in-up').forEach((el) => beobachter.observe(el));
      } else {
        document.querySelectorAll('.fade-in-up').forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
