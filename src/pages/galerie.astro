---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { galleryImagesQuery, galleryPageQuery } from '../lib/queries';
import { galleryImagesFallback, galleryPageFallback } from '../lib/content';
import { getContent, getSiteSettings } from '../lib/site';
import { urlFor, getImageAlt } from '../lib/image';
import type { GalleryImage, GalleryPage } from '../types/sanity';

const siteSettings = await getSiteSettings();
const galleryPage = await getContent<GalleryPage>(galleryPageQuery, galleryPageFallback);
const bilder = await getContent<GalleryImage[]>(galleryImagesQuery, galleryImagesFallback);
const instagram = siteSettings.socialLinks?.find((link) => link.plattform === 'instagram');
---

<BaseLayout
  title={galleryPage.titel}
  description={`Bildergalerie von ${siteSettings.studioName} – Einblicke in Studio und Behandlungen.`}
  seo={galleryPage.seo}
>
  <PageHeader eyebrow="Einblicke" title={galleryPage.titel} lead={galleryPage.einleitung} />

  <section class="section">
    <div class="container">
      <div class="row g-3">
        {bilder.map((eintrag) => {
          const url = urlFor(eintrag.bild, 900);
          const altText = getImageAlt(eintrag.bild, eintrag.titel || 'Impression aus dem Studio');
          return url ? (
            <div class="col-6 col-md-4">
              <button type="button" class="gallery-card fade-in-up" data-lightbox-trigger aria-label={`Bild vergrößern: ${altText}`}>
                <img src={url} alt={altText} loading="lazy" width="900" height="1125" />
              </button>
            </div>
          ) : null;
        })}
      </div>
      {instagram && (
        <div class="text-center mt-5">
          <a class="btn btn-outline-dark" href={instagram.url} target="_blank" rel="noopener noreferrer">Mehr auf Instagram</a>
        </div>
      )}
    </div>
  </section>

  <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Bild-Vorschau" hidden>
    <button type="button" id="lightbox-close" class="btn btn-light btn-sm lightbox__close">Schließen</button>
    <img id="lightbox-image" src="data:," alt="" />
  </div>
</BaseLayout>

<script>
  // Schlanke, abhängigkeitsfreie Lightbox für die Galeriebilder.
  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const schliessenButton = document.getElementById('lightbox-close');
  let ausloeser: HTMLElement | null = null;

  function oeffnen(button: HTMLElement, src: string, alt: string) {
    if (!lightbox || !lightboxImage) return;
    ausloeser = button;
    lightboxImage.src = src;
    lightboxImage.alt = alt;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    schliessenButton?.focus();
  }

  function schliessen() {
    if (!lightbox || lightbox.hidden) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
    ausloeser?.focus();
  }

  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]').forEach((button) => {
    button.addEventListener('click', () => {
      const img = button.querySelector('img');
      if (img) oeffnen(button, img.src, img.alt);
    });
  });

  schliessenButton?.addEventListener('click', schliessen);
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) schliessen();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') schliessen();
  });
</script>
