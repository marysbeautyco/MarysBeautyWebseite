---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Seite nicht gefunden" description="Diese Seite konnte leider nicht gefunden werden.">
  <PageHeader eyebrow="Fehler 404" title="Seite nicht gefunden" lead="Die aufgerufene Seite existiert leider nicht (mehr).">
    <div class="d-flex flex-wrap justify-content-center gap-3">
      <a href="/" class="btn btn-primary">Zur Startseite</a>
      <a href="/behandlungen" class="btn btn-outline-dark">Behandlungen</a>
    </div>
  </PageHeader>
</BaseLayout>
