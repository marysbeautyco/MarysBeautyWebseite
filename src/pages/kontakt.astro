---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import ContactDetails from '../components/ContactDetails.astro';
import PageHeader from '../components/PageHeader.astro';
import { contactPageQuery } from '../lib/queries';
import { contactPageFallback } from '../lib/content';
import { getContent, getSiteSettings } from '../lib/site';
import { adresseEinzeilig, telefonHref } from '../lib/contact';
import type { ContactPage } from '../types/sanity';

const siteSettings = await getSiteSettings();
const contactPage = await getContent<ContactPage>(contactPageQuery, contactPageFallback);
---

<BaseLayout
  title={contactPage.titel}
  description={`Kontakt zu ${siteSettings.studioName}: ${adresseEinzeilig(siteSettings)}, Telefon ${siteSettings.telefon}.`}
  seo={contactPage.seo}
>
  <PageHeader eyebrow="Wir sind für Sie da" title={contactPage.titel} lead={contactPage.einleitung} />

  <section class="section">
    <div class="container">
      <div class="row g-5 align-items-stretch">
        <div class="col-lg-7">
          <ContactDetails settings={siteSettings} />
        </div>
        <div class="col-lg-5">
          <div class="booking-panel surface-dark">
            <h2>Ihr Termin</h2>
            <p class="text-soft mb-4">Wählen Sie Ihre Wunschbehandlung und einen passenden Termin, oder rufen Sie uns einfach an.</p>
            <div class="d-flex flex-wrap gap-3">
              <BookingButton settings={siteSettings} variant="light" />
              <a class="btn btn-outline-light" href={telefonHref(siteSettings.telefon)}>Anrufen</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
