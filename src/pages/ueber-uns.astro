---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityFetch } from '../lib/sanity';
import { aboutPageQuery, siteSettingsQuery } from '../lib/queries';
import { aboutPageFallback, siteSettingsFallback } from '../lib/content';
import { urlFor, getImageAlt } from '../lib/image';
import { richTextToHtml } from '../lib/richtext';
import type { AboutPage, SiteSettings } from '../types/sanity';

const siteSettings = (await sanityFetch<SiteSettings>(siteSettingsQuery)) ?? siteSettingsFallback;
const about = (await sanityFetch<AboutPage>(aboutPageQuery)) ?? aboutPageFallback;

const bildUrl = urlFor(about.bild, 1200);
const philosophieHtml = richTextToHtml(about.philosophieText);
const team = [...(about.team ?? [])].sort((a, b) => (a.reihenfolge ?? 0) - (b.reihenfolge ?? 0));
---

<BaseLayout title={about.titel} description={`Lernen Sie ${siteSettings.studioName} und unser Team kennen.`} seo={about.seo}>
  <section class="section">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
          <h1 class="section-title">{about.titel}</h1>
          <hr class="divider" />
          <p class="section-lead">
            {siteSettings.studioName} steht für individuelle Kosmetikbehandlungen in ruhiger, hochwertiger Atmosphäre.
            Wir nehmen uns Zeit für Sie und Ihre Haut.
          </p>
        </div>
        <div class="col-lg-6">
          {bildUrl ? (
            <img src={bildUrl} alt={getImageAlt(about.bild, 'Innenansicht des Studios')} class="img-fluid rounded-4" loading="lazy" />
          ) : (
            <div class="bg-sand rounded-4 d-flex align-items-center justify-content-center" style="aspect-ratio: 4/3;">
              <span class="opacity-50">Bild folgt</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  {about.philosophieTitel && (
    <section class="section bg-champagne-soft">
      <div class="container">
        <div class="row justify-content-center text-center">
          <div class="col-lg-8">
            <h2 class="section-title">{about.philosophieTitel}</h2>
            <hr class="divider mx-auto" />
            {philosophieHtml ? (
              <div class="section-lead mx-auto text-start text-lg-center" set:html={philosophieHtml} />
            ) : (
              <p class="section-lead mx-auto">
                Wir glauben an natürliche Schönheit, individuelle Beratung und hochwertige Pflege – fernab von
                Zeitdruck und Massenabfertigung.
              </p>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {team.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="text-center mb-5">
          <h2 class="section-title">Unser Team</h2>
          <hr class="divider mx-auto" />
        </div>
        <div class="row g-4 justify-content-center">
          {team.map((mitglied) => {
            const teamBildUrl = urlFor(mitglied.bild, 480);
            return (
              <div class="col-md-6 col-lg-4">
                <div class="team-card rounded-4 p-4 text-center h-100 fade-in-up">
                  {teamBildUrl ? (
                    <img
                      src={teamBildUrl}
                      alt={getImageAlt(mitglied.bild, mitglied.name)}
                      class="rounded-circle mx-auto mb-3"
                      style="width: 7rem; height: 7rem; object-fit: cover;"
                      loading="lazy"
                      width="112"
                      height="112"
                    />
                  ) : (
                    <div
                      class="rounded-circle bg-sand mx-auto mb-3 d-flex align-items-center justify-content-center"
                      style="width: 7rem; height: 7rem;"
                    >
                      <span class="opacity-50">Foto</span>
                    </div>
                  )}
                  <h3 class="h5 mb-1">{mitglied.name}</h3>
                  {mitglied.rolle && <p class="text-uppercase small opacity-75 mb-2">{mitglied.rolle}</p>}
                  {mitglied.beschreibung && <p class="opacity-75 mb-0">{mitglied.beschreibung}</p>}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
