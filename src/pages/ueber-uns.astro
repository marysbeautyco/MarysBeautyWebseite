---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchVisual from '../components/ArchVisual.astro';
import BookingButton from '../components/BookingButton.astro';
import { aboutPageQuery } from '../lib/queries';
import { aboutPageFallback } from '../lib/content';
import { getContent, getSiteSettings } from '../lib/site';
import { urlFor, getImageAlt } from '../lib/image';
import { richTextToHtml } from '../lib/richtext';
import type { AboutPage } from '../types/sanity';

const siteSettings = await getSiteSettings();
const about = await getContent<AboutPage>(aboutPageQuery, aboutPageFallback);

const philosophieHtml = richTextToHtml(about.philosophieText);
const team = [...(about.team ?? [])].sort((a, b) => (a.reihenfolge ?? 0) - (b.reihenfolge ?? 0));
---

<BaseLayout title={about.titel} description={`Lernen Sie ${siteSettings.studioName} in ${siteSettings.adresse.ort} kennen.`} seo={about.seo}>
  <section class="hero">
    <div class="container">
      <div class="row align-items-center gx-lg-5">
        <div class="col-lg-7">
          <div class="hero__copy">
            <span class="eyebrow">{siteSettings.studioName}</span>
            <h1 class="hero__title">{about.titel}</h1>
            <p class="hero__text mb-0">
              {siteSettings.studioName} steht für individuelle Kosmetikbehandlungen in ruhiger, hochwertiger Atmosphäre.
              Wir nehmen uns Zeit für Sie und Ihre Haut.
            </p>
          </div>
        </div>
        <div class="col-lg-5 hero__visual">
          <div class="arch-frame">
            <ArchVisual src={urlFor(about.bild, 1200)} alt={getImageAlt(about.bild, 'Innenansicht des Studios')} eager />
          </div>
        </div>
      </div>
    </div>
  </section>

  {about.philosophieTitel && philosophieHtml && (
    <section class="section">
      <div class="container">
        <div class="row gy-3">
          <div class="col-lg-5">
            <h2 class="section-title mb-0">{about.philosophieTitel}</h2>
          </div>
          <div class="col-lg-6 offset-lg-1">
            <div class="section-lead" set:html={philosophieHtml} />
          </div>
        </div>
      </div>
    </section>
  )}

  {team.length > 0 && (
    <section class="section bg-linen">
      <div class="container">
        <div class="text-center mb-5">
          <h2 class="section-title mb-0">{team.length > 1 ? 'Unser Team' : 'Ihre Ansprechpartnerin'}</h2>
        </div>
        <div class="row g-5 justify-content-center">
          {team.map((mitglied) => (
            <div class="col-md-6 col-lg-4">
              <div class="team-card fade-in-up">
                <ArchVisual src={urlFor(mitglied.bild, 640)} alt={getImageAlt(mitglied.bild, mitglied.name)} />
                <h3>{mitglied.name}</h3>
                {mitglied.rolle && <span class="eyebrow">{mitglied.rolle}</span>}
                {mitglied.beschreibung && <p class="text-soft mb-0">{mitglied.beschreibung}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section text-center">
    <div class="container">
      <h2 class="section-title">Lernen wir uns kennen</h2>
      <BookingButton settings={siteSettings} size="lg" class="mt-2" />
    </div>
  </section>
</BaseLayout>
