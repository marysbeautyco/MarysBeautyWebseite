---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchVisual from '../components/ArchVisual.astro';
import BookingButton from '../components/BookingButton.astro';
import ContactDetails from '../components/ContactDetails.astro';
import Icon from '../components/Icon.astro';
import { homePageQuery, treatmentCategoriesQuery, treatmentsQuery } from '../lib/queries';
import { homePageFallback, treatmentCategoriesFallback, treatmentsFallback } from '../lib/content';
import { getContent, getSiteSettings, groupTreatments } from '../lib/site';
import { urlFor, getImageAlt } from '../lib/image';
import type { HomePage, Treatment, TreatmentCategory } from '../types/sanity';

const siteSettings = await getSiteSettings();
const homePage = await getContent<HomePage>(homePageQuery, homePageFallback);
const kategorien = await getContent<TreatmentCategory[]>(treatmentCategoriesQuery, treatmentCategoriesFallback);
const treatments = await getContent<Treatment[]>(treatmentsQuery, treatmentsFallback);

const gruppen = groupTreatments(kategorien, treatments);
const galerieBilder = (homePage.galerieVorschau ?? []).slice(0, 4);
const standort = `Kosmetikstudio in ${siteSettings.adresse.ort}`;
---

<BaseLayout
  title={standort}
  description={`${siteSettings.studioName} – ${standort}. ${siteSettings.claim ?? 'Individuelle Pflege und Wohlbefinden.'}`}
  seo={homePage.seo}
>
  <section class="hero">
    <div class="container">
      <div class="row align-items-center gx-lg-5">
        <div class="col-lg-7">
          <div class="hero__copy">
            <span class="eyebrow">{standort}</span>
            <h1 class="hero__title">{homePage.heroUeberschrift}</h1>
            <p class="hero__text">{homePage.heroText}</p>
            <div class="hero__actions">
              <BookingButton settings={siteSettings} label={homePage.heroButtonText || 'Termin buchen'} size="lg" />
              <a href="/behandlungen" class="link-arrow">Behandlungen <Icon name="arrow" size={15} /></a>
            </div>
          </div>
        </div>
        <div class="col-lg-5 hero__visual">
          <div class="arch-frame">
            <ArchVisual src={urlFor(homePage.heroBild, 1200)} alt={getImageAlt(homePage.heroBild, '')} eager />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="row gy-3">
        <div class="col-lg-5">
          {homePage.kurzvorstellungTitel && <h2 class="section-title mb-0">{homePage.kurzvorstellungTitel}</h2>}
        </div>
        <div class="col-lg-6 offset-lg-1">
          {homePage.kurzvorstellungText && <p class="section-lead mb-4">{homePage.kurzvorstellungText}</p>}
          <a href="/ueber-uns" class="link-arrow">Mehr über uns <Icon name="arrow" size={15} /></a>
        </div>
      </div>
    </div>
  </section>

  {gruppen.length > 0 && (
    <section class="section pt-0">
      <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-5">
          <div>
            <span class="eyebrow">Leistungen</span>
            <h2 class="section-title mb-0">Unsere Behandlungen</h2>
          </div>
          <a href="/behandlungen" class="link-arrow">Alle ansehen <Icon name="arrow" size={15} /></a>
        </div>
        <div class="row g-5 g-lg-4">
          {gruppen.map(({ kategorie }) => (
            <div class="col-md-4">
              <a class="category-card fade-in-up" href={`/behandlungen#${kategorie.slug.current}`}>
                <ArchVisual src={urlFor(kategorie.bild, 900)} alt={getImageAlt(kategorie.bild, kategorie.titel)} />
                <h3>{kategorie.titel}</h3>
                {kategorie.beschreibung && <p>{kategorie.beschreibung}</p>}
                <span class="link-arrow">Entdecken <Icon name="arrow" size={15} /></span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {homePage.vorteile && homePage.vorteile.length > 0 && (
    <section class="section surface-dark">
      <div class="container">
        <span class="eyebrow">Warum Marys Beauty</span>
        <div class="row g-4 g-lg-5 mt-1">
          {homePage.vorteile.map((vorteil) => (
            <div class="col-md-6 col-lg-3">
              <div class="benefit fade-in-up">
                <h3>{vorteil.titel}</h3>
                <p>{vorteil.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {galerieBilder.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
          <h2 class="section-title mb-0">Impressionen</h2>
          <a href="/galerie" class="link-arrow">Zur Galerie <Icon name="arrow" size={15} /></a>
        </div>
        <div class="row g-3">
          {galerieBilder.map((bild) => {
            const url = urlFor(bild, 640);
            return url ? (
              <div class="col-6 col-lg-3">
                <div class="gallery-card fade-in-up">
                  <img src={url} alt={getImageAlt(bild, 'Impression aus dem Studio')} loading="lazy" width="640" height="800" />
                </div>
              </div>
            ) : null;
          })}
        </div>
      </div>
    </section>
  )}

  <section class="section bg-linen">
    <div class="container">
      <div class="row gy-5">
        <div class="col-lg-5">
          <span class="eyebrow">Besuchen Sie uns</span>
          <h2 class="section-title">Wir freuen uns auf Sie</h2>
          <p class="section-lead mb-4">
            Buchen Sie Ihren Wunschtermin oder sprechen Sie uns direkt an. Wir beraten Sie gerne persönlich.
          </p>
          <BookingButton settings={siteSettings} size="lg" />
        </div>
        <div class="col-lg-6 offset-lg-1">
          <ContactDetails settings={siteSettings} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
