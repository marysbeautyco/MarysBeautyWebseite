---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingButton from '../../components/BookingButton.astro';
import PageHeader from '../../components/PageHeader.astro';
import TreatmentRow from '../../components/TreatmentRow.astro';
import { treatmentCategoriesQuery, treatmentsQuery } from '../../lib/queries';
import { treatmentCategoriesFallback, treatmentsFallback } from '../../lib/content';
import { getContent, getSiteSettings, groupTreatments } from '../../lib/site';
import type { Treatment, TreatmentCategory } from '../../types/sanity';

const siteSettings = await getSiteSettings();
const kategorien = await getContent<TreatmentCategory[]>(treatmentCategoriesQuery, treatmentCategoriesFallback);
const treatments = await getContent<Treatment[]>(treatmentsQuery, treatmentsFallback);

const ohneKategorie = treatments.filter((t) => !t.kategorie);
const gruppen = groupTreatments(kategorien, treatments);
---

<BaseLayout
  title="Behandlungen"
  description={`Alle Behandlungen bei ${siteSettings.studioName} in ${siteSettings.adresse.ort}: Facials, Permanent Make-up, Lash & Brow Lifting und Laserhaarentfernung.`}
>
  <PageHeader
    eyebrow="Leistungen"
    title="Unsere Behandlungen"
    lead="Jede Anwendung wird auf Ihre Haut und Ihre Wünsche abgestimmt. Aktuelle Preise, Dauer und freie Termine sehen Sie direkt bei der Buchung."
  >
    <BookingButton settings={siteSettings} />
  </PageHeader>

  {gruppen.length > 1 && (
    <nav class="border-bottom" aria-label="Kategorien">
      <div class="container">
        <ul class="chip-nav">
          {gruppen.map(({ kategorie }) => (
            <li><a href={`#${kategorie.slug.current}`}>{kategorie.titel}</a></li>
          ))}
        </ul>
      </div>
    </nav>
  )}

  <section class="section">
    <div class="container">
      {gruppen.map(({ kategorie, treatments: eintraege }) => (
        <div class="row gy-4 treatment-group" id={kategorie.slug.current}>
          <div class="col-lg-4">
            <div class="treatment-group__heading">
              <h2>{kategorie.titel}</h2>
              {kategorie.beschreibung && <p class="text-soft mb-0">{kategorie.beschreibung}</p>}
            </div>
          </div>
          <div class="col-lg-7 offset-lg-1">
            <div class="treatment-list">
              {eintraege.map((treatment) => <TreatmentRow treatment={treatment} settings={siteSettings} />)}
            </div>
          </div>
        </div>
      ))}

      {ohneKategorie.length > 0 && (
        <div class="row gy-4 treatment-group">
          <div class="col-lg-4">
            <div class="treatment-group__heading">
              <h2>Weitere Behandlungen</h2>
            </div>
          </div>
          <div class="col-lg-7 offset-lg-1">
            <div class="treatment-list">
              {ohneKategorie.map((treatment) => <TreatmentRow treatment={treatment} settings={siteSettings} />)}
            </div>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
