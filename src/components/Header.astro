---
import BookingButton from './BookingButton.astro';
import type { SiteSettings } from '../types/sanity';
import { urlFor } from '../lib/image';

interface Props {
  siteSettings: SiteSettings;
}

const { siteSettings } = Astro.props;
const logoUrl = urlFor(siteSettings.logo, 320) ?? '/brand/marys-beauty-logo-espresso-480.png';
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Start' },
  { href: '/behandlungen', label: 'Behandlungen' },
  { href: '/ueber-uns', label: 'Über uns' },
  { href: '/galerie', label: 'Galerie' },
  { href: '/kontakt', label: 'Kontakt' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <nav class="navbar navbar-expand-lg navbar-light" aria-label="Hauptnavigation">
    <div class="container">
      <a class="navbar-brand" href="/" aria-label={`${siteSettings.studioName} – zur Startseite`}>
        <img src={logoUrl} alt={siteSettings.studioName} width="98" height="56" />
      </a>
      <button
        class="navbar-toggler nav-toggle"
        type="button"
        aria-controls="haupt-navigation"
        aria-expanded="false"
        aria-label="Navigation öffnen"
        data-nav-toggle
      >
        <span></span>
        <span></span>
      </button>
      <div class="collapse navbar-collapse" id="haupt-navigation">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          {navLinks.map((link) => (
            <li class="nav-item">
              <a class="nav-link" href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
          <li class="nav-item ms-lg-3 mt-3 mt-lg-0 d-none d-lg-block">
            <BookingButton settings={siteSettings} size="sm" />
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>

<script>
  // Minimaler Navigation-Toggle ohne bootstrap.bundle.js, da weder Dropdowns
  // noch Tooltips benötigt werden.
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.getElementById('haupt-navigation');

  function setzeStatus(offen: boolean) {
    menu?.classList.toggle('show', offen);
    toggle?.setAttribute('aria-expanded', String(offen));
    toggle?.setAttribute('aria-label', offen ? 'Navigation schließen' : 'Navigation öffnen');
  }

  toggle?.addEventListener('click', () => setzeStatus(!menu?.classList.contains('show')));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setzeStatus(false)));
</script>
