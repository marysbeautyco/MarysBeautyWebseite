---
import { urlFor, getImageAlt } from '../lib/image';
import type { Treatment } from '../types/sanity';

interface Props {
  treatment: Treatment;
  planityUrl: string;
}

const { treatment, planityUrl } = Astro.props;
const bildUrl = urlFor(treatment.bild, 640);
const buchungsUrl = treatment.planityUrl?.trim() || planityUrl;
---

<article class="treatment-card rounded-4 p-4 d-flex flex-column fade-in-up">
  {bildUrl && (
    <img
      src={bildUrl}
      alt={getImageAlt(treatment.bild, treatment.titel)}
      class="rounded-3 mb-3"
      style="aspect-ratio: 4/3; object-fit: cover; width: 100%;"
      loading="lazy"
      width="640"
      height="480"
    />
  )}
  {treatment.kategorie && (
    <p class="text-uppercase small opacity-75 mb-1">{treatment.kategorie.titel}</p>
  )}
  <h3 class="h5">{treatment.titel}</h3>
  <p class="opacity-75 flex-grow-1">{treatment.kurzbeschreibung}</p>
  <a href={buchungsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark btn-sm align-self-start mt-2">
    Behandlung buchen
  </a>
</article>
