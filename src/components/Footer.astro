---
import { emailHref, socialLabels, telefonHref } from '../lib/contact';
import type { SiteSettings } from '../types/sanity';

interface Props {
  siteSettings: SiteSettings;
}

const { siteSettings } = Astro.props;
const jahr = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="row gy-5">
      <div class="col-lg-4">
        <img
          class="footer__logo"
          src="/brand/marys-beauty-logo-creme-480.png"
          alt={siteSettings.studioName}
          width="155"
          height="88"
          loading="lazy"
        />
        {siteSettings.claim && <p class="mb-0">{siteSettings.claim}</p>}
      </div>

      <div class="col-6 col-lg-2">
        <p class="footer__heading">Entdecken</p>
        <ul class="footer__links">
          <li><a href="/behandlungen">Behandlungen</a></li>
          <li><a href="/ueber-uns">Über uns</a></li>
          <li><a href="/galerie">Galerie</a></li>
          <li><a href="/termin">Termin buchen</a></li>
        </ul>
      </div>

      <div class="col-6 col-lg-3">
        <p class="footer__heading">Kontakt</p>
        <address>
          {siteSettings.adresse.strasse}<br />
          {siteSettings.adresse.plz} {siteSettings.adresse.ort}
        </address>
        <ul class="footer__links mt-2">
          <li><a href={telefonHref(siteSettings.telefon)}>{siteSettings.telefon}</a></li>
          <li class="text-break"><a href={emailHref(siteSettings.email)}>{siteSettings.email}</a></li>
          {siteSettings.socialLinks?.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {socialLabels[link.plattform] ?? link.plattform}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col-lg-3">
        <p class="footer__heading">Öffnungszeiten</p>
        <ul class="footer__links">
          {siteSettings.oeffnungszeiten.map((zeile) => (
            <li class="d-flex justify-content-between gap-3">
              <span>{zeile.tag}</span>
              <span>{zeile.zeiten}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {jahr} {siteSettings.studioName}</p>
      <nav aria-label="Rechtliches">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </nav>
    </div>
  </div>
</footer>
