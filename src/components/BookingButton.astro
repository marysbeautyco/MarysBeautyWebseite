---
import { getBookingHref } from '../lib/booking';
import type { SiteSettings } from '../types/sanity';

interface Props {
  settings: SiteSettings;
  treatmentUrl?: string;
  label?: string;
  variant?: 'primary' | 'light' | 'outline-light' | 'outline-dark';
  size?: 'sm' | 'lg';
  class?: string;
}

const { settings, treatmentUrl, label = 'Termin buchen', variant = 'primary', size, class: className = '' } = Astro.props;
const href = getBookingHref(settings, treatmentUrl);
const isExternal = /^https?:/.test(href);
---

<a
  href={href}
  class:list={['btn', `btn-${variant}`, size && `btn-${size}`, className]}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  data-planity-booking
>
  {label}
</a>
